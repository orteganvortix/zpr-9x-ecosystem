#!/bin/bash
ACTION="$1"
NODE_NAME="$2"
NODE_FINGERPRINT="$3"
PEER_DB="zpr_peers.dat"

if [ "$ACTION" = "add" ]; then
    if [ -z "$NODE_NAME" ] || [ -z "$NODE_FINGERPRINT" ]; then
        echo "Penggunaan: zpr-peers add <nama_node> <sidik_jari_1024bit>"
        exit 1
    fi
    echo "$NODE_NAME:$NODE_FINGERPRINT" >> "$PEER_DB"
    echo "[✔] Node peer '$NODE_NAME' berhasil didaftarkan ke registri kedaulatan!"

elif [ "$ACTION" = "list" ]; then
    echo "=================================================="
    echo "    ZPR SOVEREIGN DECENTRALIZED PEER REGISTRY     "
    echo "=================================================="
    if [ ! -f "$PEER_DB" ]; then
        echo "Belum ada node peer yang terdaftar."
    else
        python3 -c '
import sys
db_file = sys.argv[1]
with open(db_file, "r") as f:
    peers = [line.strip() for line in f if line.strip()]

print(f"Total Peer Terdaftar: {len(peers)}\n")
for i, peer in enumerate(peers, 1):
    name, fp = peer.split(":", 1)
    print(f"[{i}] Nama Node : {name}")
    print(f"    Fingerprint: {fp[:32]}...")
    print("-" * 50)
' "$PEER_DB"
    fi
    echo "=================================================="
else
    echo "=== ZPR-PEERS REGISTRY MANAGER ==="
    echo "1. Tambah Peer : zpr-peers add <nama> <sidik_jari>"
    echo "2. Daftar Peer : zpr-peers list"
fi
