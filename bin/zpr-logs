#!/bin/bash
LEDGER="zpr_chain.dat"

echo "=================================================="
echo "    ZPR SOVEREIGN LEDGER TRANSACTION EXPLORER     "
echo "=================================================="

if [ ! -f "$LEDGER" ]; then
    echo "Error: Berkas rantai ledger belum ditemukan."
    exit 1
fi

python3 -c '
import sys

ledger_file = sys.argv[1]
with open(ledger_file, "r") as f:
    blocks = [line.strip() for line in f if line.strip()]

print(f"Total Blok Tercatat di Ledger: {len(blocks)}\n")
for i, block in enumerate(blocks, 1):
    parts = block.split(" ", 1)
    h = parts[0]
    payload = parts[1] if len(parts) > 1 else "Kosong"
    
    print(f"[Blok #{i}]")
    print(f" Hash Sempurna : {h}")
    print(f" Payload Data  : {payload}")
    print("-" * 50)
' "$LEDGER"

echo "=================================================="
